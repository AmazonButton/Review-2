stateDiagram-v2
    state "PENDING_PAYMENT" as PENDING_PAYMENT
    state "PAID" as PAID
    state "ACTIVE" as ACTIVE
    state "RETURN_REQUESTED / Owner request; current-state guard absent" as RETURN_REQUESTED
    state "TERMINATED / CANCELLED / Recognized by extension guard" as TERMINATED
